# ============================================================
# CLIO DPOF — long-options-only trading engine (agent/dpof/)
# Every var below is read by agent.dpof.config.load_dpof_config().
# Operator directive (2026-09-24): "paper mode IS the soak" (no separate
# log-only staging period) and "everything is built active, not shadow"
# (defaults are the ACTIVE modes) — mode defaults to PAPER: the engine
# trades a paper account from the FIRST cycle unless CLIO_DPOF_MODE is
# explicitly set to off/log_only. LIVE is unaffected: every gate in
# docs/design/clio_dpof.md §7 still applies regardless of this default.
# See docs/design/clio_dpof.md §11 for the live go-live checklist.
# Blank = code default applies.
# ============================================================

# --- Mode / identity ---
CLIO_DPOF_MODE=paper
# CLIO_DPOF_UNDERLYINGS=SPY,QQQ
# CLIO_DPOF_DATA_DIR=
# CLIO_DPOF_ORDER_PREFIX=DPOF

# --- Alpaca account: dedicated keys preferred. If CLIO_DPOF_ALPACA_KEY_ID/
# _SECRET_KEY are BOTH unset and CLIO_DPOF_ALPACA_PAPER=true, DPOF falls back
# to CLIO's own existing shared paper keys -- the ALPACA_PAPER_KEY_ID/
# ALPACA_PAPER_SECRET_KEY that agent/config.py reads for paper trading --
# never mixed with a partial dedicated id/secret, and never for a live
# account. See DPOFConfig.alpaca_key_source ("dedicated" | "clio_paper" |
# "none") in `/dpof config`. ---
CLIO_DPOF_ALPACA_KEY_ID=
CLIO_DPOF_ALPACA_SECRET_KEY=
CLIO_DPOF_ALPACA_PAPER=true
# "opra" (default -- operator confirmed Algo Trader Plus / real-time OPRA on
# the account) | "auto" (try OPRA, fall back to indicative on a 401/403) |
# "indicative" (explicit, no OPRA attempt). Falls back to ALPACA_OPTIONS_FEED
# if unset here, then the code default.
# CLIO_DPOF_OPTIONS_FEED=opra
# CLIO_DPOF_STOCK_FEED=sip                 # falls back to ALPACA_STOCK_FEED, then "sip" (Algo Trader Plus)

# --- Virtual capital for a SHARED Alpaca account (e.g. via the clio_paper
# fallback above, which may hold other, non-DPOF positions/balance). Sizing
# and risk breakers use min(real account equity, capital_base + DPOF's own
# realized+unrealized P&L) instead of the whole account's equity. Set to 0
# to disable and use the real account equity unchanged (correct for a
# dedicated account). ---
# CLIO_DPOF_CAPITAL=20000.0

# --- Live gates (ALL must pass or the engine degrades to LOG_ONLY) ---
CLIO_DPOF_LIVE_ACK=
CLIO_DPOF_LIVE_ACCOUNT=
# CLIO_DPOF_MIN_OPTIONS_LEVEL=2
# CLIO_DPOF_MIN_EQUITY=2000.0

# --- Cadence / windows (ET) ---
# CLIO_DPOF_CYCLE_SECONDS=30
# CLIO_DPOF_UW_REFRESH_SECONDS=180
# CLIO_DPOF_BARS_REFRESH_SECONDS=60
# CLIO_DPOF_ENTRY_START_ET=09:45
# CLIO_DPOF_ENTRY_END_ET=15:15
# CLIO_DPOF_FLATTEN_ET=15:50
# CLIO_DPOF_FLATTEN_EOD=true

# --- Signal (NOFA 4-pillar composite) ---
# CLIO_DPOF_W_NOFA=0.40
# CLIO_DPOF_W_PREMIUM=0.25
# CLIO_DPOF_W_DARKPOOL=0.20
# CLIO_DPOF_W_GEX=0.15
# CLIO_DPOF_MIN_PILLARS=3
# CLIO_DPOF_THRESHOLD_NORMAL=0.15
# CLIO_DPOF_THRESHOLD_STRONG=0.30
# CLIO_DPOF_DP_VETO=0.30
# CLIO_DPOF_PRICE_CONFIRM=true
# CLIO_DPOF_QQQ_DIVERGENCE=1.5
# CLIO_DPOF_EXIT_THRESHOLD=0.05

# --- Regime (VIX) ---
# CLIO_DPOF_VIX_TRENDING=18.0
# CLIO_DPOF_VIX_CHOPPY=25.0
# CLIO_DPOF_VIX_EXTREME_LABEL=35.0     # advisory "EXTREME" regime label only -- no longer a block (Task 1, 2026-09-25)
# CLIO_DPOF_VIX_MAX_AGE=900

# --- Event / regime advisory labels (Task 1, 2026-09-25): econ blackout,
# breaking news, VIX EXTREME, and vol regime are DECISION CONTEXT now, never
# a block -- see docs/design/clio_dpof.md §4/Task1. CLIO_DPOF_BLOCK_BREAKING_
# NEWS / CLIO_DPOF_BLOCK_VOL_REGIMES are RETIRED (breaking-news/vol-regime
# info always surfaces as context now, unconditionally) -- setting them no
# longer does anything. ---
# CLIO_DPOF_EVENT_CONTEXT_WINDOW_MIN=30   # importance-3 events within +/- N min surface as context
# CLIO_DPOF_STALE_ALARM_MIN=30

# --- Contract selection (1DTE standard -- the v1 5-14 DTE window and the
# theta/day filter are retired; theta is decision CONTEXT, never a gate) ---
# CLIO_DPOF_TARGET_DELTA=0.50
# CLIO_DPOF_MIN_DELTA=0.35
# CLIO_DPOF_MAX_DELTA=0.65
# CLIO_DPOF_MAX_SPREAD_PCT=0.06
# CLIO_DPOF_MIN_OI=500

# --- Verticals (debit only). Default TRUE (operator confirmed options level
# 3 on the account, 2026-09-24) -- gated at RUNTIME by the broker-reported
# account options level (>= 3), never a config-time error; an account below
# level 3 gets singles only. ---
# CLIO_DPOF_ALLOW_VERTICALS=true
# CLIO_DPOF_VERTICAL_VIX=22.0
# CLIO_DPOF_VERTICAL_WIDTH_PCT=0.015

# --- Sizing / risk envelope: operator directive (no-hard-caps amendment,
# 2026-09-24) -- entries AND exits are judged by CLIO's decision model; there
# is NO per-trade/open-premium/max-contracts cap, no entry-count cap, no
# daily/weekly/drawdown breaker, no loss-streak or re-entry cooldown any
# more. The decision model sizes directly (its own `qty`); the ONLY code-side
# bound left is SOLVENCY (agent/dpof/sizing.py's max_affordable_qty /
# clamp_to_solvency), enforced fresh at actual entry-sizing time. The
# CLIO_DPOF_RISK_PCT_*/MAX_TRADE_PREMIUM_PCT/MAX_OPEN_PREMIUM_PCT/
# MAX_CONTRACTS/MAX_POSITIONS/MAX_ENTRIES_*/REENTRY_COOLDOWN/LOSS_STREAK_*/
# DAILY_LOSS_PCT/WEEKLY_LOSS_PCT/MAX_DRAWDOWN_PCT vars that used to live here
# are RETIRED (removed from DPOFConfig once nothing else referenced them).

# --- Exits: the ONLY exit rule left is the 15:50 ET forced flatten
# (deterministic; Jev is NEVER consulted on exits, entries or reviews --
# see the Jev section below). The CLIO_DPOF_STOP_LOSS_PCT/TP_TIERS/
# BREAKEVEN_AFTER_TIER1/TRAIL_GIVEBACK/MAX_HOLD_MIN/THESIS_EXIT_VOTES vars
# that used to live here are RETIRED. ---

# --- Order handling ---
