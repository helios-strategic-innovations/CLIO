# --- Reconciliation quantity check (docs/design/clio_dpof_followups_2026-09-26.md
# §3): single-leg-long positions only. Corrects the ledger to the broker's
# quantity via a synthetic order_fills entry (avg=None) once the SAME
# (ledger,broker) mismatch has been seen twice, at least this many seconds
# apart. Ledger bookkeeping only -- never places, sizes or cancels an order. ---
# CLIO_DPOF_RECONCILE_ADOPT=true            # false: reconcile still WARNS on a quantity mismatch, never corrects it
# CLIO_DPOF_RECONCILE_CONFIRM_SECONDS=30

# --- UW budget share (inside CLIO's shared UW budget) ---
# CLIO_DPOF_UW_DAILY_CAP=1500

# --- Self-computed flow fallback (agent/flowcollector). When a UW-derived
# pillar (or NOPE/max-pain context) is unavailable/stale this cycle, data.py
# falls back to agent.flowcollector.state.get_selfflow() (Alpaca OPRA/SIP
# self-computed pillars) instead of leaving it missing -- UW always wins
# whenever it IS available. On by default (operator directive 2026-09-25:
# UW subscription/key reissue in progress). See docs/design/clio_dpof.md's
# "Flow fallback" section for the exact per-pillar mapping. ---
# CLIO_DPOF_SELFFLOW_FALLBACK=true
# CLIO_DPOF_SELFFLOW_MAX_AGE=120
# CLIO_DPOF_SELFFLOW_MIN_TRADES=20   # below this many classified trades in 5 min -> "thin" 0.0 reading

# --- Jev (TypeSafe) fast advisory/veto layer. Defaults to "veto", but Jev is
# INACTIVE (never called, never blocks an entry) until TYPESAFE_API_KEY (or
# CLIO_DPOF_JEV_KEY_FILE, or a fallback URL below) is set — it becomes active
# automatically the moment one is configured, no other flag needed. Check
# `/dpof status` or `/dpof config` for "jev: veto (inactive — no
# TYPESAFE_API_KEY)" vs "jev: veto". ---
CLIO_DPOF_JEV_MODE=veto
TYPESAFE_API_KEY=
# CLIO_DPOF_JEV_KEY_FILE=
TYPESAFE_BASE_URL=https://api.typesafe.ai
# CLIO_DPOF_JEV_MODEL=jev-1.13.0
# CLIO_DPOF_JEV_TIMEOUT=2.5
# CLIO_DPOF_JEV_CONFLICT_T=0.70
# CLIO_DPOF_JEV_EVENT_T=0.70
# CLIO_DPOF_JEV_SETUP_CONF=0.60
# CLIO_DPOF_JEV_FAIL_CLOSED=true
# CLIO_DPOF_JEV_CIRCUIT_FAILURES=3
# CLIO_DPOF_JEV_CIRCUIT_COOLDOWN=600
# CLIO_DPOF_JEV_MAX_HEADLINES=12
# Entry-veto sizing question (operator directive, no-hard-caps amendment):
# Jev may add "size_reckless" to the veto reasons when the decision model's
# chosen size looks reckless given capital/exposure/conviction/P&L context.
# CLIO_DPOF_JEV_SIZE_T=0.70
# Optional wire-compatible fallback (e.g. a self-hosted server) — empty = no fallback.
CLIO_DPOF_JEV_FALLBACK_URL=
# CLIO_DPOF_JEV_FALLBACK_MODEL=
CLIO_DPOF_JEV_FALLBACK_KEY=

# --- Judgment layer (operator directive, 2026-09-24): NO mechanical trading.
# Entries AND exits are decided by CLIO's own decision model; code only
# enforces solvency and the 15:50 ET flatten. Primary: Anthropic Opus 5.5.
# Fallback: OpenAI GPT-6 Sol (reuses OPENAI_API_KEY -- the same var CLIO's
# Whisper integration already uses; set CLIO_DPOF_FALLBACK_MODEL=off to
# disable the fallback leg entirely). Both providers down -> NO new entries,
# open positions HELD (never auto-closed), operator alerted every
# CLIO_DPOF_MODEL_DOWN_ALERT_MIN minutes; the 15:50 flatten still fires. ---
# CLIO_DPOF_DECISION_MODEL=claude-opus-5-5
# CLIO_DPOF_DECISION_EFFORT=medium         # low|medium|high|xhigh|max (thinking always on)
# CLIO_DPOF_DECISION_TIMEOUT=60.0
# CLIO_DPOF_DECISION_MAX_TOKENS=16000
# CLIO_DPOF_FALLBACK_MODEL=gpt-6-sol       # "off"/"none"/"0" disables the fallback leg
# CLIO_DPOF_FALLBACK_EFFORT=medium
# CLIO_DPOF_FALLBACK_TIMEOUT=60.0
OPENAI_API_KEY=
# CLIO_DPOF_OPENAI_BASE_URL=https://api.openai.com/v1
# CLIO_DPOF_DECIDER_CIRCUIT_FAILURES=3
# CLIO_DPOF_DECIDER_CIRCUIT_COOLDOWN=300
# CLIO_DPOF_MAX_DECISIONS_DAY=600          # cost guard: entry deliberations + reviews, shared daily cap
# CLIO_DPOF_DECISION_MAX_AGE=120           # a harvested decision older than this (seconds) is discarded

# --- Position review cadence (the decider re-judges each OPEN position on
# this cadence, or sooner on a trigger: Jev sentinel escalation, a mark move
# >= CLIO_DPOF_REVIEW_TRIGGER_MOVE, composite/VWAP flipped against the
# position, or breaking news). Triggers only ever SCHEDULE a review -- never
# trade by themselves. ---
# CLIO_DPOF_REVIEW_MINUTES=5
# CLIO_DPOF_REVIEW_MIN_MINUTES=1
# CLIO_DPOF_REVIEW_MAX_MINUTES=15
# CLIO_DPOF_REVIEW_TRIGGER_MOVE=0.15
# CLIO_DPOF_MODEL_DOWN_ALERT_MIN=15

# --- Entry deliberation cadence (per underlying+direction; bypassed early if
# the composite strengthens by >= CLIO_DPOF_ENTRY_REDELIB_DELTA, or once the
# decider's own recheck_minutes elapses). ---
# CLIO_DPOF_ENTRY_CANDIDATES=3             # contracts offered to the decider per deliberation
# CLIO_DPOF_ENTRY_DELIB_COOLDOWN=300
# CLIO_DPOF_ENTRY_REDELIB_DELTA=0.10

# --- Expiry policy: 1DTE standard (Hydrinia DPOF design intent) ---
# CLIO_DPOF_EXPIRY_SESSIONS=1              # 1 = next trading session's expiry (Fri -> Mon)
# CLIO_DPOF_MAX_EXPIRY_SESSIONS=2          # fallback sessions tried if the target expiry has no liquid candidates

# --- Learning loop F1: post-trade lessons (agent/dpof/reflection.py, Task
# ORCH-7Q4K-DPOF builder B2, 2026-09-26 -- docs/design/
# clio_dpof_learning_loop.md). Context only -- lessons/tallies are never a
# rule, a gate, or a vote; they only enter the decider's own prompt. ---
# CLIO_DPOF_REFLECTION=true                 # master gate for the whole post-trade reflection loop
# CLIO_DPOF_LESSONS_IN_PROMPT=true          # inject stored lessons into entry/review prompts
# CLIO_DPOF_REFLECTION_MODEL=               # "" -> falls back to CLIO_DPOF_DECISION_MODEL at call time
# CLIO_DPOF_REFLECTION_FALLBACK_MODEL=      # "" -> falls back to CLIO_DPOF_FALLBACK_MODEL
# CLIO_DPOF_REFLECTION_TIMEOUT=60.0
# CLIO_DPOF_REFLECTION_LOOKBACK_DAYS=7
# CLIO_DPOF_REFLECTION_MAX_ATTEMPTS=3       # per position; then permanently skipped (no lesson, ever)
# CLIO_DPOF_REFLECTION_MAX_PER_RUN=2        # eligible positions reflected on per cycle
# CLIO_DPOF_LESSONS_SAME_UNDERLYING=5       # max recent lessons shown for the nominated/position underlying
# CLIO_DPOF_LESSONS_CROSS=3                 # max recent lessons shown for OTHER underlyings
# CLIO_DPOF_LESSONS_PROMPT_MAX_CHARS=2500
# CLIO_DPOF_LESSON_ALERTS=true              # one plain-text Telegram line per new lesson

# --- Learning loop F2: borderline debate context (bull/bear from a faster
# model), same task/design-doc reference as F1 above. Advisory only -- never
# a vote, never blocks/accelerates an exit on its own. Entries: only when a
# "normal"-strength signal is within CLIO_DPOF_DEBATE_MARGIN of the entry
# threshold. Reviews: only on an alignment_against trigger, never alongside a
# Jev escalation, and only with >= CLIO_DPOF_DEBATE_REVIEW_MIN_MINUTES left to
# the flatten. ---
# CLIO_DPOF_DEBATE=true
# CLIO_DPOF_DEBATE_REVIEWS=true
# CLIO_DPOF_DEBATE_MODEL=claude-sonnet-5
# CLIO_DPOF_DEBATE_FALLBACK_MODEL=gpt-6-sol   # "off"/"none"/"0" disables the fallback leg
# CLIO_DPOF_DEBATE_MARGIN=0.05
# CLIO_DPOF_DEBATE_TIMEOUT=20.0
# CLIO_DPOF_DEBATE_REVIEW_TIMEOUT=12.0
# CLIO_DPOF_DEBATE_REVIEW_MIN_MINUTES=30

# --- agent/flowcollector (self-computed UW-style options-flow pillars, feeds
# the CLIO_DPOF_SELFFLOW_FALLBACK block above). Own process
# (`python -m agent.flowcollector`), own systemd unit
# (systemd/clio-flowcollector.service), reuses the shared ALPACA_PAPER_KEY_ID/
# ALPACA_PAPER_SECRET_KEY above -- no separate credentials. See
# agent/flowcollector/config.py for every knob (this is the subset worth
# tuning; the rest have sane defaults). ---
# CLIO_FLOWCOLLECTOR_UNDERLYINGS=SPY,QQQ
# CLIO_FLOWCOLLECTOR_STRIKE_BAND_PCT=0.04
# CLIO_FLOWCOLLECTOR_MAX_DTE=2
# CLIO_FLOWCOLLECTOR_OPTIONS_FEED=opra     # "opra" or "indicative"
# CLIO_FLOWCOLLECTOR_STOCK_FEED=sip        # "sip" or "iex" ONLY (live stream limitation)
#
# Self-computed (Black-Scholes-Merton) greeks fallback (2026-09-25 fix --
# see agent/flowcollector/greeks.py's module docstring): used whenever
# Alpaca's own OPRA/indicative snapshot greeks are missing or fail a sanity
# check. risk_free_rate/dividend_yield are continuously-compounded ANNUAL
# rates; dividend_yield is a single flat value (not per-underlying).
# CLIO_FLOWCOLLECTOR_RISK_FREE_RATE=0.04
# CLIO_FLOWCOLLECTOR_DIVIDEND_YIELD=0.012
# CLIO_FLOWCOLLECTOR_GREEKS_RECOMPUTE_SECONDS=60      # network-free recompute cadence, between the slower OI/Alpaca-greeks REST pulls
# CLIO_FLOWCOLLECTOR_STRIKES_REFRESH_SECONDS=900      # OI + Alpaca-greeks REST pull cadence
# CLIO_FLOWCOLLECTOR_STRIKES_SPOT_RETRY_SECONDS=30    # short retry cadence when a strikes refresh is due but has no spot yet (startup)
# CLIO_FLOWCOLLECTOR_MAX_SPREAD_PCT_FOR_IV=0.5        # (ask-bid)/mid above this -> quote too wide to trust for an IV solve
# "No fake zeros": below these OI-weighted (gex) / traded-volume-weighted
# (nope) coverage fractions, gex/nope report None (unavailable) instead of a
# value computed mostly off contracts with an unknown greek.
# CLIO_FLOWCOLLECTOR_GEX_MIN_COVERAGE=0.5
# CLIO_FLOWCOLLECTOR_NOPE_MIN_COVERAGE=0.5
#
# State/comparison-log file paths (defaults under data/intelligence/ --
# override only for a non-standard layout).
# CLIO_SELFFLOW_FILE=data/intelligence/selfflow_state.json
# CLIO_SELFFLOW_COMPARE_FILE=data/intelligence/selfflow_compare.jsonl

